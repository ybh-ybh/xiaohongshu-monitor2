# 小红书浏览器与轮询配置
HEADLESS=true
CHECK_INTERVAL_MINUTES=5
XHS_USER_DATA_DIR=./data/browser-profile

# 容器日志配置：生产环境推荐 JSON；本地阅读可改为 pretty
LOG_LEVEL=info
LOG_FORMAT=json
# 是否记录 API 请求；健康检查默认不记录，避免每 30 秒刷屏
LOG_REQUESTS=true
LOG_HEALTH_CHECKS=false
# 仅排查页面提取问题时临时开启，常规监控不要持续截图
SCRAPE_DEBUG_SCREENSHOT=false

# 管理后台登录凭据（必须修改为你自己的强密码）
AUTH_USERNAME=admin
AUTH_PASSWORD=请替换为至少16位的随机强密码
# HTTPS 部署建议设为 true；本地 HTTP 调试保持 false
AUTH_COOKIE_SECURE=false
# 会话有效期，单位为小时，默认 168（7天）
AUTH_SESSION_TTL_HOURS=168

# 163 SMTP 配置：MAIL_PASSWORD 填客户端授权码，不要填网页登录密码
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USERNAME=你的163邮箱
MAIL_PASSWORD=你的163客户端授权码
# 多个收件人用英文逗号或分号分隔；也可继续使用旧的 MAIL_RECIPIENT 单收件人配置
MAIL_RECIPIENTS=收件人1@example.com,收件人2@example.com
